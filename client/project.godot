; Engine configuration file.
; BWMMO prototype client. Placeholder art only; no ROM assets are bundled.

config_version=5

[application]

config/name="BWMMO Prototype"
config/description="A minimal online Pokemon-style prototype: shared world, chat, NPCs, and server-authoritative battles."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Loc="*res://scripts/loc.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[internationalization]

locale/translations=PackedStringArray("res://i18n/zh_CN.po")
locale/fallback="en"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-Regular.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043137, 0.066667, 0.090196, 1)
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=2
