{
  "name": "bwmmo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative prototype server for BWMMO",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate-content": "tsx scripts/validate-content.ts",
    "build-content": "tsx scripts/build-game-content.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@pkmn/sim": "^0.10.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
