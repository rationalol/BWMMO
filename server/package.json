{
  "name": "bwmmo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative prototype server for BWMMO",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "validate-content": "tsx scripts/validate-content.ts",
    "story:lint": "tsx scripts/story-lint.ts",
    "build-content": "tsx scripts/build-game-content.ts",
    "build:ability-i18n": "tsx scripts/build-ability-i18n.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:story": "tsx scripts/story-smoke.ts",
    "smoke:social": "tsx scripts/social-smoke.ts",
    "smoke:duel": "tsx scripts/duel-smoke.ts",
    "smoke:growth": "tsx scripts/growth-smoke.ts",
    "audit:maps": "python ../tools/rom/audit_maps.py --report ../.tools/map-audit/report.md",
    "audit:assets": "python ../tools/rom/audit_assets.py",
    "audit:assets:test": "python ../tools/rom/audit_assets.py --self-test"
  },
  "dependencies": {
    "@pkmn/sim": "^0.10.11",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
